{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "EdgeSwarm Node",
    "version":  "1.5.18",
    "identifier":  "com.edgeswarm.node",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Edge Swarm Provider Node",
                                    "width":  600,
                                    "height":  360
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1M0ZFNTA2NzgwRkE4RjkKUldUNXFBOTRCdVUvWlpSSnNTelBYWnc4cFBBRk5SVFN5dEFZeWxsbHVHZm9OenhWZXlIWlJCNCsK",
                                    "endpoints":  [
                                                      "https://api.edgeswarm.io/node/desktop-update/{{target}}/{{arch}}/{{current_version}}"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}