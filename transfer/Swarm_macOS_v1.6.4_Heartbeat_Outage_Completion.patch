-fn transient_node_transport_errors_are_classified_v1() {
+// MACOS_HEARTBEAT_TRANSIENT_FAILOPEN_FOR_AVAILABILITY_V1
+// Only transient transport/server errors are tolerated on macOS.
+// Authentication rejection, version gating, and invalid evidence fail closed.
+fn tolerate_macos_transient_heartbeat_v1(
+    result: Result<u16, String>,
+    context: &str,
+) -> Result<Option<u16>, String> {
+    match result {
+        Ok(status) => Ok(Some(status)),
+        Err(error)
+            if cfg!(target_os = "macos")
+                && transient_node_transport_error_v1(&error) =>
+        {
+            println!("MACOS_HEARTBEAT_TRANSIENT_ERROR={context}|{error}");
+            Ok(None)
+        }
+        Err(error) => Err(error),
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn macos_heartbeat_transient_is_not_a_fatal_restart_v1() {
+    assert_eq!(
+        tolerate_macos_transient_heartbeat_v1(Ok(200), "unit").unwrap(),
+        Some(200)
+    );
+    assert!(tolerate_macos_transient_heartbeat_v1(
+        Err("heartbeat_http_401".into()),
+        "unit"
+    ).is_err());
+    #[cfg(target_os = "macos")]
+    assert_eq!(
+        tolerate_macos_transient_heartbeat_v1(
+            Err("supabase_refresh_request_failed:transport".into()), "unit"
+        ).unwrap(),
+        None
+    );
+}
