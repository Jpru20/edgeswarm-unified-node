# EdgeSwarm Unified Node headless configuration
#
# Copy this file to:
#   /etc/edgeswarm-node/<username>/node.env
#
# Supply values appropriate for the installation.
# Do not commit credentials into this file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
GCP_BASE_URL=

# Optional overrides when using externally managed models/runtime:
# EDGESWARM_DATA_DIR=
# EDGESWARM_MODEL_ROOT=
# EDGESWARM_LLAMA_SERVER_PATH=
# EDGESWARM_EXECUTION_ACCELERATION=
